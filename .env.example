# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo .env (ele já está no .gitignore).

# Chave de API da Groq (obrigatória) - crie em https://console.groq.com/keys
GROQ_API_KEY=cole_sua_chave_aqui

# Modelo usado para classificar o escopo e responder
GROQ_MODEL=llama-3.3-70b-versatile

# Tamanho máximo da mensagem do usuário (mantenha igual ao maxlength do textarea em static/index.html)
MAX_MESSAGE_CHARS=500

# Limite de mensagens por minuto, por IP
RATE_LIMIT_PER_MINUTE=20

# Servidor local
HOST=127.0.0.1
PORT=5000

# 1 ativa o modo debug do Flask (use apenas em desenvolvimento)
FLASK_DEBUG=0
